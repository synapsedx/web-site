# Force browsers to revalidate HTML/CSS/JS so deploys show up immediately.
# "no-cache" lets the browser store the file but it must check with the server
# (conditional request → 304 if unchanged, fresh content if it changed).
<IfModule mod_headers.c>
    <FilesMatch "\.(html|js|css)$">
        Header set Cache-Control "no-cache, must-revalidate"
    </FilesMatch>

    # Long-lived caching for static assets that rarely change.
    <FilesMatch "\.(jpg|jpeg|png|gif|webp|svg|ico|woff2?|ttf)$">
        Header set Cache-Control "public, max-age=2592000"
    </FilesMatch>
</IfModule>
